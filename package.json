{
  "name": "obsidian-linear-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An editable Linear board in Obsidian daily notes.",
  "main": "main.js",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --platform=browser --format=cjs --target=es2020 --external:obsidian --outfile=main.js"
  },
  "engines": { "node": ">=22.18.0" },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "obsidian": "1.14.4",
    "typescript": "5.9.3"
  }
}
